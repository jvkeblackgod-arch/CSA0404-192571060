21. Worst Fit Memory Allocation
#include <stdio.h>

int main()
{
    int block[20], process[20];
    int n, m, i, j;
    int allocation[20];

    printf("Enter number of memory blocks: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++)
    {
        printf("Enter size of Block %d: ", i + 1);
        scanf("%d", &block[i]);
    }

    printf("Enter number of processes: ");
    scanf("%d", &m);

    for (i = 0; i < m; i++)
    {
        printf("Enter memory required for P%d: ", i + 1);
        scanf("%d", &process[i]);
        allocation[i] = -1;
    }

    for (i = 0; i < m; i++)
    {
        int worst = -1;

        for (j = 0; j < n; j++)
        {
            if (block[j] >= process[i])
            {
                if (worst == -1 || block[j] > block[worst])
                    worst = j;
            }
        }

        if (worst != -1)
        {
            allocation[i] = worst;
            block[worst] -= process[i];
        }
    }

    printf("\nProcess\tAllocation\n");

    for (i = 0; i < m; i++)
    {
        if (allocation[i] != -1)
            printf("P%d\tBlock %d\n", i + 1, allocation[i] + 1);
        else
            printf("P%d\tNot Allocated\n", i + 1);
    }

    return 0;
}


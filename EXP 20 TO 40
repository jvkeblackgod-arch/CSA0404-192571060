38. SCAN Disk Scheduling

This example assumes the disk head initially moves toward 0.

#include <stdio.h>
#include <stdlib.h>

int main()
{
    int request[50];
    int n, head, disk_size;
    int i, j, temp;
    int total = 0;

    printf("Enter disk size: ");
    scanf("%d", &disk_size);

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    for (i = 0; i < n - 1; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (request[i] > request[j])
            {
                temp = request[i];
                request[i] = request[j];
                request[j] = temp;
            }
        }
    }

    printf("\nSCAN Order:\n");

    /* Requests smaller than head */
    for (i = n - 1; i >= 0; i--)
    {
        if (request[i] <= head)
        {
            printf("%d -> ", head);
            total += abs(head - request[i]);
            head = request[i];
        }
    }

    /* Move to disk 0 */
    printf("%d -> ", head);
    total += head;
    head = 0;

    /* Requests greater than original head */
    for (i = 0; i < n; i++)
    {
        if (request[i] > head)
        {
            printf("%d -> ", head);
            total += abs(head - request[i]);
            head = request[i];
        }
    }

    printf("%d\n", head);

    printf("\nTotal head movement = %d\n", total);

    return 0;
}

39. C-SCAN Disk Scheduling
#include <stdio.h>
#include <stdlib.h>

int main()
{
    int request[50];
    int n, head, disk_size;
    int i, j, temp;
    int total = 0;
    int original;

    printf("Enter disk size: ");
    scanf("%d", &disk_size);

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    original = head;

    for (i = 0; i < n - 1; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (request[i] > request[j])
            {
                temp = request[i];
                request[i] = request[j];
                request[j] = temp;
            }
        }
    }

    printf("\nC-SCAN Order:\n");

    /* Move towards higher cylinder numbers */
    for (i = 0; i < n; i++)
    {
        if (request[i] >= original)
        {
            printf("%d -> ", head);
            total += abs(head - request[i]);
            head = request[i];
        }
    }

    /* Move to end of disk */
    printf("%d -> ", head);
    total += (disk_size - 1) - head;
    head = disk_size - 1;

    /* Jump to beginning */
    printf("%d -> ", head);
    total += disk_size - 1;
    head = 0;

    /* Service remaining requests */
    for (i = 0; i < n; i++)
    {
        if (request[i] < original)
        {
            printf("%d -> ", head);
            total += abs(head - request[i]);
            head = request[i];
        }
    }

    printf("%d\n", head);

    printf("\nTotal head movement = %d\n", total);

    return 0;
}

40. File Access Permissions and Types of Users in Linux

Linux has three main types of users:

Owner/User (u)
Group (g)
Others (o)

Permissions:

r = Read
w = Write
x = Execute

This program uses stat() to display permissions.

#include <stdio.h>
#include <sys/stat.h>

int main()
{
    char filename[50];
    struct stat st;

    printf("Enter file name: ");
    scanf("%s", filename);

    if (stat(filename, &st) != 0)
    {
        printf("File not found\n");
        return 1;
    }

    printf("\nFile Permissions:\n");

    printf("Owner/User : ");

    if (st.st_mode & S_IRUSR)
        printf("r");
    else
        printf("-");

    if (st.st_mode & S_IWUSR)
        printf("w");
    else
        printf("-");

    if (st.st_mode & S_IXUSR)
        printf("x");
    else
        printf("-");

    printf("\nGroup      : ");

    if (st.st_mode & S_IRGRP)
        printf("r");
    else
        printf("-");

    if (st.st_mode & S_IWGRP)
        printf("w");
    else
        printf("-");

    if (st.st_mode & S_IXGRP)
        printf("x");
    else
        printf("-");

    printf("\nOthers     : ");

    if (st.st_mode & S_IROTH)
        printf("r");
    else
        printf("-");

    if (st.st_mode & S_IWOTH)
        printf("w");
    else
        printf("-");

    if (st.st_mode & S_IXOTH)
        printf("x");
    else
        printf("-");

    printf("\n");

    return 0;
}



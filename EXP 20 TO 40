        frames[i] = -1;

    for (i = 0; i < n; i++)
    {
        hit = 0;

        for (j = 0; j < f; j++)
        {
            if (frames[j] == pages[i])
            {
                hit = 1;
                break;
            }
        }

        if (!hit)
        {
            faults++;
            pos = -1;
            farthest = -1;

            for (j = 0; j < f; j++)
            {
                if (frames[j] == -1)

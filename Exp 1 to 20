12. Dining Philosophers Problem

Simple semaphore-based solution.

#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

#define N 5

sem_t fork_sem[N];

void *philosopher(void *arg)
{
    int id = *(int *)arg;

    printf("Philosopher %d is thinking\n", id);

    sleep(1);

    sem_wait(&fork_sem[id]);
    sem_wait(&fork_sem[(id + 1) % N]);

    printf("Philosopher %d is eating\n", id);
    sleep(2);

    sem_post(&fork_sem[id]);
    sem_post(&fork_sem[(id + 1) % N]);

    printf("Philosopher %d finished eating\n", id);

    return NULL;
}

int main()
{
    pthread_t threads[N];
    int id[N];
    int i;

    for (i = 0; i < N; i++)
    {
        sem_init(&fork_sem[i], 0, 1);
        id[i] = i;
    }

    for (i = 0; i < N; i++)
        pthread_create(&threads[i], NULL, philosopher, &id[i]);

    for (i = 0; i < N; i++)
        pthread_join(threads[i], NULL);

    return 0;
}



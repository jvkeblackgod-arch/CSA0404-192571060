13. Memory Allocation Strategies

Implements First Fit, Best Fit and Worst Fit.

#include <stdio.h>

int main()
{
    int blocks[20], process[20];
    int n, m, i, j;
    int choice, allocated[20];

    printf("Enter number of memory blocks: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++)
    {
        printf("Enter size of block %d: ", i + 1);
        scanf("%d", &blocks[i]);
    }

    printf("Enter number of processes: ");
    scanf("%d", &m);

    for (i = 0; i < m; i++)
    {
        printf("Enter memory required by P%d: ", i + 1);
        scanf("%d", &process[i]);
    }

    printf("\n1. First Fit");
    printf("\n2. Best Fit");
    printf("\n3. Worst Fit");

    printf("\nEnter choice: ");
    scanf("%d", &choice);

    for (i = 0; i < m; i++)
        allocated[i] = -1;

    for (i = 0; i < m; i++)
    {
        int index = -1;

        for (j = 0; j < n; j++)
        {
            if (blocks[j] >= process[i])
            {
                if (choice == 1)
                {
                    index = j;
                    break;
                }
                else if (choice == 2)
                {
                    if (index == -1 || blocks[j] < blocks[index])
                        index = j;
                }
                else if (choice == 3)
                {
                    if (index == -1 || blocks[j] > blocks[index])
                        index = j;
                }
            }
        }

        if (index != -1)
        {
            allocated[i] = index;
            blocks[index] -= process[i];
        }
    }

    printf("\nProcess\tMemory Block\n");

    for (i = 0; i < m; i++)
    {
        if (allocated[i] != -1)
            printf("P%d\tBlock %d\n", i + 1, allocated[i] + 1);
        else
            printf("P%d\tNot Allocated\n", i + 1);
    }

    return 0;
}


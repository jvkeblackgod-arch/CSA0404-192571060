        if (choice == 1)
        {
            printf("Enter file name: ");
            scanf("%s", name);

            strcpy(files[n], name);
            n++;

            printf("File created\n");
        }
        else if (choice == 2)
        {
            printf("\nFiles:\n");

            for (int i = 0; i < n; i++)
                printf("%s\n", files[i]);
        }
        else if (choice == 3)
        {
            printf("Enter file name to delete: ");
            scanf("%s", name);

            for (int i = 0; i < n; i++)
            {
                if (strcmp(files[i], name) == 0)
                {
                    for (int j = i; j < n - 1; j++)
                        strcpy(files[j], files[j + 1]);

                    n--;
                    printf("File deleted\n");
                    break;
                }
            }
        }
        else
        {
